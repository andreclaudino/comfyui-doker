# Docker ignore file for ComfyUI Docker build

# Git
.git
.gitignore
.github

# Documentation
*.md
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Build artifacts
*.egg-info/
dist/
build/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# ComfyUI runtime directories (will be created at runtime)
models/
output/
input/
custom_nodes/
user/

# Logs
*.log

# Temporary files
*.tmp
*.temp
tmp/
temp/