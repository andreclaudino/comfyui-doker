# ComfyUI Docker image — Intel XPU
# Based on Ubuntu 22.04 with Intel compute runtime, Level Zero, and PyTorch XPU
# Requires nodeSelector: { intel.com/gpu.present: "true" } in Kubernetes

ARG COMFYUI_REF=master

FROM ubuntu:22.04

ARG COMFYUI_REF

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies and Intel compute runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-pip \
    python3-venv \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Intel GPU drivers and compute runtime
RUN wget -qO - https://repositories.intel.com/gpu/intel-graphics.key | gpg --dearmor -o /usr/share/keyrings/intel-gpu.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/intel-gpu.gpg] https://repositories.intel.com/gpu/ubuntu jammy unified" | tee /etc/apt/sources.list.d/intel-gpu.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    intel-opencl-icd \
    intel-level-zero-gpu \
    level-zero \
    intel-media-va-driver-non-free \
    libmfx1 \
    libmfxgen1 \
    libvpl2 \
    libegl1-mesa \
    libegl1 \
    libdrm2 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace

RUN git clone --depth 1 --branch ${COMFYUI_REF} \
    https://github.com/comfyanonymous/ComfyUI.git /workspace/ComfyUI

WORKDIR /workspace/ComfyUI

# Install PyTorch from Intel XPU index
RUN pip3 install --no-cache-dir torch torchvision torchaudio \
    --index-url https://pytorch.org/whl/xpu && \
    pip3 install --no-cache-dir -r requirements.txt && \
    rm -rf /root/.cache/pip

RUN mkdir -p custom_nodes models output input user

COPY docker/entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENV PYTHONPATH=/workspace/ComfyUI
ENV PYTHONDONTWRITEBYTECODE=1
ENV COMFYUI_PORT=8188
ENV COMFYUI_HOST=0.0.0.0
ENV COMFYUI_ARGS="--listen 0.0.0.0 --port 8188"
ENV COMFYUI_CUSTOM_NODES="https://github.com/ltdrdata/ComfyUI-Manager.git"
ENV SYCL_CACHE_PERSISTENT=1
ENV ONEAPI_DEVICE_SELECTOR=level_zero:0

EXPOSE 8188

ENTRYPOINT ["/workspace/entrypoint.sh"]
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
